#!/bin/bash

running=$(osascript -e 'tell application "System Events" to get bundle identifier of (every process whose background only is false)' | sed 's/, /\n/g' | sort)
docked=$(defaults read com.apple.dock persistent-apps | grep 'bundle-identifier' | cut -d '"' -f4 | sort)

# echo "- RUNNING -"
# echo "$running"
# echo "- DOCKED -"
# echo "$docked"
# exit

keep=$(cat <(echo "$docked") <(cat ~/.config/bin/keep-apps.txt) | sort)

undocked_running=$(comm -13 <(echo "$keep") <(echo "$running"))
echo "$undocked_running"

osascript -e "on run argv
    repeat with appID in argv
        try
            tell application id appID
                quit
            end tell
        end try
    end repeat
end run" $undocked_running

