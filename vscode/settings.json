{
    //style
    "editor.fontFamily": "Fantasque Sans Mono, Menlo, Monaco, 'Courier New', monospace",
    "editor.fontSize": 14,
    "editor.wordWrap": "on",

    "workbench.iconTheme": "catppuccin-frappe",

    // editor
    "editor.formatOnSave": true,
    "editor.minimap.enabled": false,
    "editor.multiCursorModifier": "ctrlCmd",
    "editor.renderWhitespace": "all",
    "editor.scrollbar.verticalScrollbarSize": 20,
    "editor.stickyScroll.enabled": true,
    "editor.suggest.showReferences": false,

    // files
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.openEditors.visible": 0,
    "explorer.confirmPasteNative": false,
    "files.exclude": {
        "**/__pycache__": true
    },

    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 200,

    // window
    "window.autoDetectColorScheme": true,
    "window.commandCenter": true,
    "workbench.activityBar.location": "top",

    "workbench.editor.decorations.colors": false,
    "workbench.layoutControl.enabled": false,
    "workbench.layoutControl.type": "toggles",
    "workbench.tips.enabled": false,
    "workbench.tree.renderIndentGuides": "always",
    "workbench.sideBar.location": "right",
    "workbench.editor.empty.hint": "hidden",
    "workbench.panel.showLabels": false,


    // git
    "git.autofetch": true,
    "git.blame.editorDecoration.enabled": false,
    "git.blame.statusBarItem.enabled": false,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "git.timeline.showUncommitted": true,
    "git.openRepositoryInParentFolders": "never",

    "diffEditor.hideUnchangedRegions.enabled": true,
    "diffEditor.ignoreTrimWhitespace": false,

    // terminal    
    "problems.showCurrentInStatus": true,
    "terminal.integrated.bellDuration": 10000,
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.enableImages": true,
    "terminal.integrated.tabs.enabled": false,
    "terminal.integrated.fontSize": 14,
    "terminal.integrated.initialHint": false,
    
    // sephiroth (go away, cloud)
    "extensions.autoUpdate": "onlyEnabledExtensions",
    "settingsSync.ignoredExtensions": [],
    "telemetry.telemetryLevel": "off",

    // go away, ai
    "editor.inlineSuggest.enabled": false,
    "chat.agent.enabled": false,
    "chat.disableAIFeatures": true,

    //
    //  LANGUAGE-SPECIFICS
    //

    // Misc files
    "[tsv]": {
        "editor.insertSpaces": false
    },
    "[json]": {
        "editor.defaultFormatter": "j-brooke.fracturedjsonvsc",
    },

    // Web
    "css.format.enable": false,
    "[javascript, typescript, css]": {
        "editor.tabSize": 2
    },

    // Python
    "python.createEnvironment.trigger": "off",
    "python.defaultInterpreterPath": "/opt/homebrew/bin/python3.14",
    "python.interpreter.infoVisibility": "never",
    "python.testing.autoTestDiscoverOnSaveEnabled": false,

    "python.languageServer": "Pylance",
    "python.analysis.autoFormatStrings": true,
    "python.analysis.importFormat": "relative",
    "python.analysis.supportDocstringTemplate": true,
    "python.analysis.typeEvaluation.strictDictionaryInference": true,
    "python.analysis.typeEvaluation.strictListInference": true,
    "python.analysis.typeEvaluation.strictSetInference": true,
    "python.analysis.inlayHints.functionReturnTypes": true,
    "autopep8.importStrategy": "fromEnvironment",

    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
    },
    "python.analysis.typeCheckingMode": "standard",
    "autopep8.interpreter": [
        "python3.14"
    ],
    
    // Python: Notebooks
    "notebook.cellToolbarVisibility": "hover",
    "notebook.insertToolbarLocation": "betweenCells",
    "notebook.output.textLineLimit": 80,
    "notebook.showCellStatusBar": "visibleAfterExecute",
    "jupyter.askForKernelRestart": false,

    // Lua
    "Lua.telemetry.enable": false,
    "Lua.codeLens.enable": true,
    "Lua.workspace.library": [
        "/Users/yunruse/Developer/PlaydateSDK"
    ],
    "playdate-debug.productName": "calculatrice",
    "playdate-debug.outputPath": "",

    // Misc academic
    "lammps.AutoComplete.Setting": "None",
    "r.rpath.mac": "/usr/local/bin/r",
    "python.terminal.activateEnvironment": false,
    "python-envs.terminal.autoActivationType": "off",

    //
    // new settings hot and fresh off the GUI
    //
}